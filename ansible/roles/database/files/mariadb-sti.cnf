# sti-db01 : MariaDB partagée par les nœuds WordPress (géré par Ansible, rôle database)
[mysqld]
# Écoute sur le réseau (Debian n'écoute par défaut que sur 127.0.0.1).
# L'accès est limité aux réseaux autorisés au niveau des comptes (voir tasks/main.yml).
bind-address = 0.0.0.0

# Les comptes sont définis par adresse IP : inutile (et lent) de résoudre les noms.
skip-name-resolve

character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
