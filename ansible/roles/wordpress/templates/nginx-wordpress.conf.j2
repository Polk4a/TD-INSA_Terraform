# Site WordPress des nœuds nginx + php-fpm (sti-wp*).
# Géré par Ansible (rôle wordpress, templates/nginx-wordpress.conf.j2) : ne pas éditer à la main.
# Le socket php-fpm est celui de la version de PHP réellement installée.

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    root  {{ wordpress_webroot }};
    index index.php;

    # Envoi de médias (le défaut nginx est de 1 Mo)
    client_max_body_size 64m;
{% if wordpress_proxy_ips | length > 0 %}

    # --- Derrière HAProxy -----------------------------------------------------
    # L'IP réelle du client vient de X-Forwarded-For, mais seulement si la requête
    # arrive d'HAProxy : pour tout autre appelant, l'en-tête est ignoré (infalsifiable).
{% for ip in wordpress_proxy_ips %}
    set_real_ip_from {{ ip }};
{% endfor %}
    real_ip_header   X-Forwarded-For;
{% endif %}
{% if wordpress_only_from_proxy and wordpress_proxy_ips | length > 0 %}
{% set proxy_regex = wordpress_proxy_ips | map('regex_escape') | join('|') %}

    # Les WordPress ne répondent qu'à HAProxy (et à eux-mêmes : sondes du rôle wordpress).
    # $realip_remote_addr = adresse TCP réelle de l'appelant, même après real_ip.
    if ($realip_remote_addr !~ ^(127\.0\.0\.1|{{ proxy_regex }})$) {
        return 403;
    }
{% endif %}

    # Sonde de vivacité (nginx seul) : utilisée par le rôle wordpress
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Sonde de disponibilité pour HAProxy : php-fpm ET base partagée joignables.
    # 200 = le nœud peut servir WordPress, 503 = HAProxy le retire du round-robin.
    location = /readyz {
        access_log off;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/healthz/readyz.php;
        fastcgi_pass unix:/run/php/php{{ wordpress_php_version }}-fpm.sock;
    }

    # Fichiers cachés interdits (sauf /.well-known)
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Jamais de PHP exécuté dans les uploads (doit rester AVANT le bloc \.php$)
    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php{{ wordpress_php_version }}-fpm.sock;
        fastcgi_param PHP_VALUE "upload_max_filesize=64M \n post_max_size=64M";
    }

    location = /favicon.ico { log_not_found off; access_log off; }
    location = /robots.txt  { log_not_found off; access_log off; }
}
