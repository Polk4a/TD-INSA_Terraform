<?php
/**
 * wp-config.php des nœuds WordPress : géré par Ansible (rôle wordpress, templates/wp-config.php.j2), ne pas éditer à la main.
 *
 * - Base de données PARTAGÉE (sti-db01) : aucune base locale sur ce nœud.
 * - Clés et sels identiques sur tous les nœuds WordPress.
 * - Fonctionne derrière HAProxy (URL et HTTPS déduits des en-têtes de la requête).
 */

// --- Base de données (MariaDB partagée) ------------------------------------
define( 'DB_NAME',     '{{ wp_db_name }}' );
define( 'DB_USER',     '{{ wp_db_user }}' );
define( 'DB_PASSWORD', '{{ wp_db_password }}' );
define( 'DB_HOST',     '{{ wordpress_db_host }}' );
define( 'DB_CHARSET',  'utf8mb4' );
define( 'DB_COLLATE',  '' );

// --- Clés et sels d'authentification ---------------------------------------
// Doivent être IDENTIQUES sur sti-wp01 et sti-wp02 : sinon, avec le round-robin
// d'HAProxy, une session ouverte sur un nœud est invalide sur l'autre.
{% for key in wordpress_salt_names %}
define( '{{ key }}', '{{ (wp_db_password ~ ':' ~ key) | hash('sha512') }}' );
{% endfor %}

$table_prefix = 'wp_';

define( 'WP_DEBUG', false );

// --- Derrière HAProxy -------------------------------------------------------
// HTTPS terminé sur le load balancer : HAProxy envoie X-Forwarded-Proto (et écrase
// celui du client). Les WordPress n'acceptant que HAProxy (voir le site nginx), cet
// en-tête ne peut pas être falsifié.
if ( isset( $_SERVER['HTTP_X_FORWARDED_PROTO'] ) && 'https' === $_SERVER['HTTP_X_FORWARDED_PROTO'] ) {
	$_SERVER['HTTPS'] = 'on';
}

// URL du site déduite de la requête (en-tête Host, transmis tel quel par HAProxy) :
// le site fonctionne derrière http://IP-ou-nom-du-LB, quel que soit le nœud qui répond.
if ( isset( $_SERVER['HTTP_HOST'] ) ) {
	$wp_scheme = ( ! empty( $_SERVER['HTTPS'] ) && 'off' !== $_SERVER['HTTPS'] ) ? 'https' : 'http';
	define( 'WP_HOME',    $wp_scheme . '://' . $_SERVER['HTTP_HOST'] );
	define( 'WP_SITEURL', $wp_scheme . '://' . $_SERVER['HTTP_HOST'] );
}

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}

require_once ABSPATH . 'wp-settings.php';
