# haproxy.cfg de sti-lb01 : géré par Ansible (rôle haproxy, templates/haproxy.cfg.j2), ne pas éditer à la main.
# Les serveurs du backend viennent du groupe « wordpress » de l'inventaire : aucune IP en dur.

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    # expose-fd listeners : rechargement à chaud sans perdre une seule connexion
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    # Connexion impossible : nouvel essai (3 max) immédiatement sur un autre nœud
    option  redispatch 1
    retries 3
    timeout connect         5s
    timeout client          60s
    timeout server          90s
    timeout http-request    10s
    timeout http-keep-alive 10s
    timeout queue           30s
    timeout check           3s
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 408 /etc/haproxy/errors/408.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

# Point d'entrée unique : port 80, réparti entre les nœuds WordPress
frontend http_front
    bind *:80
    # HAProxy est le seul proxy devant WordPress : on écrase ce que le client envoie.
    # (X-Forwarded-For est ensuite reposé par "option forwardfor" avec l'IP réelle.)
    http-request del-header X-Forwarded-For
    http-request set-header X-Forwarded-Proto http
    default_backend wordpress_back

backend wordpress_back
    balance roundrobin

    # Un nœud n'est « UP » que si php-fpm répond ET si la base partagée est joignable
    # (/readyz : voir readyz.php). 3 échecs de suite = retiré du round-robin (~6 s),
    # 2 succès de suite = remis en service, avec une montée en charge progressive.
    option httpchk
    http-check send meth GET uri /readyz ver HTTP/1.1 hdr Host haproxy-healthcheck
    http-check expect status 200
    option log-health-checks
    default-server check inter 2s fall 3 rise 2 slowstart 10s

    # Reprise sur incident : une requête de lecture (GET, HEAD, OPTIONS) est rejouée sur
    # l'autre nœud si celui-ci coupe la connexion ou répond 502/503 (php-fpm arrêté,
    # maintenance WordPress en cours...). Toute autre méthode (POST...) n'est rejouée que si
    # la connexion a échoué AVANT l'envoi de la requête : un formulaire ou une commande
    # n'est jamais exécuté deux fois. 504 n'est volontairement pas rejoué (nœud saturé).
    retry-on conn-failure empty-response 502 503
    http-request disable-l7-retry unless METH_GET || METH_OPTIONS

    # Rend le round-robin visible : curl -I http://<IP-HAProxy>/ | grep -i x-served-by
    http-response set-header X-Served-By %s

    # Nœuds WordPress : un par hôte du groupe « wordpress » de l'inventaire
{% for host in groups['wordpress'] %}
    server {{ host }} {{ hostvars[host].ansible_host }}:80
{% endfor %}
{% if haproxy_stats_cidrs | length > 0 %}

# Page d'état en lecture seule : http://<IP-HAProxy>:8404/stats
listen stats
    bind *:8404
    acl stats_src src 127.0.0.1 {{ haproxy_stats_cidrs | join(' ') }}
    http-request deny unless stats_src
    stats enable
    stats uri /stats
    stats refresh 5s
    stats hide-version
{% endif %}
